# Variables de la función /api/respuesta. En Vercel se cargan solas al conectar
# la integración de Supabase (Vercel → Integrations → Supabase). NUNCA las pongas
# en public/ ni en el repo.

# Supabase → Project Settings → API
SUPABASE_URL=https://skzmbiwgiolpovwbwpcd.supabase.co
# Clave secreta: solo vive en el servidor. La integración de Vercel carga SUPABASE_SECRET_KEY;
# si la cargás a mano también sirve SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# Opcional: sal para el hash de IP. Si no se define, se usa la service role key.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
IP_HASH_SALT=
