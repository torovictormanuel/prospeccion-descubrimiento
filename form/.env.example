# Variables de la función /api/respuesta. Se cargan en Vercel → Settings → Environment Variables.
# NUNCA las pongas en public/ ni en el repo.

# Las respuestas se guardan en el embudo unificado (Supabase victortoro-web) a través de la web:
EMBUDO_URL=https://victortoro-web.vercel.app
# Secreto compartido con la web (allá se llama DESCUBRIMIENTO_SECRET). Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EMBUDO_SECRET=

# Opcional: sal para el hash de IP. Si no se define, se usa EMBUDO_SECRET.
IP_HASH_SALT=
