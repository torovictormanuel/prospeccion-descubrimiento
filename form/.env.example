# Variables de la función /api/respuesta (cargalas en Vercel → Settings → Environment Variables).
# NUNCA las pongas en public/ ni en el repo.

# Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave secreta (service role): solo vive en el servidor
SUPABASE_SERVICE_ROLE_KEY=

# Sal para el hash de IP (cualquier texto largo y aleatorio):
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
IP_HASH_SALT=
