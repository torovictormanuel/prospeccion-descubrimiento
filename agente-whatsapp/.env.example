# Descubrimiento — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# Haiku alcanza de sobra para charlas cortas de descubrimiento y es
# el más barato (centavos de dólar por conversación).
ANTHROPIC_MODEL=claude-haiku-5-5

# ── Proveedor de WhatsApp ──────────────────────────────────
# Opciones: meta | twilio — Meta es el recomendado (las conversaciones
# que inicia el cliente desde el link wa.me no requieren plantilla).
WHATSAPP_PROVIDER=meta

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ────────────
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=
# META_APP_SECRET=

# ── Twilio (si WHATSAPP_PROVIDER=twilio) ──────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Cal.com (agenda de la llamada) ────────────────────────
# API key: Cal.com → Settings → Developer → API Keys
# Event type ID: abrí tu evento de 20 min, el número está en la URL
# Si dejás CAL_API_KEY vacío el agente solo comparte CAL_LINK.
CAL_API_KEY=
CAL_EVENT_TYPE_ID=7696927
CAL_LINK=https://cal.com/victor-toro-sa1hch/descubrimiento
TIMEZONE=America/Argentina/Buenos_Aires

# ── Sincronización con n8n ────────────────────────────────
# Clave larga y aleatoria que n8n manda en el header X-API-Key.
# Generala con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_API_KEY=

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
